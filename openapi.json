{
  "openapi": "3.0.0",
  "info": {
    "title": "Auth API",
    "version": "1.0.0",
    "description": "Authentication API using Express and Supabase"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/auth/signup": {
      "post": {
        "summary": "Create a new user"
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login user"
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Logout user",
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/public/info": {
      "get": {
        "summary": "Public endpoint"
      }
    },
    "/protected/profile": {
      "get": {
        "summary": "User profile",
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/protected/dashboard": {
      "get": {
        "summary": "Dashboard",
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  }
}    